{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Vy's default Renovate configuration. Use this as your baseline",
  "extends": [
    "config:recommended",
    "group:recommended",
    ":separateMajorReleases",
    ":semanticCommits"
  ],

  "dependencyDashboard": true,

  "branchPrefix": "renovate-",

  "timezone": "Europe/Oslo",
  "schedule": ["* 0-6 * * 1-5"],

  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,

  // Leave at 7 days of baking time before including an update,
  // that should allow most supply chain attacks to be discovered
  // and resolved. We do 14 days to be extra careful
  "minimumReleaseAge": "14 days",

  "hostRules": [
    {
      "matchHost": "nexus.common-services.vydev.io",
      "username": "github-actions-read",
      "password": "{{env.NEXUS_GHA_READ_USER}}"
    }
  ],

  "npmrc": "@vy:registry=https://nexus.common-services.vydev.io/repository/npm-group/",

  "packageRules": [
    {
      "description": "Maven registry",
      "matchDatasources": ["maven"],
      "registryUrls": ["https://nexus.common-services.vydev.io/repository/maven-public/"]
    },
    {
      "description": "Group patch updates together",
      "matchUpdateTypes": ["patch"],
      "groupName": "patch updates",
      "groupSlug": "patch",
      // Trying to find a balance between being careful about automerging,
      // whilst ensuring that patches are regularly merged,
      // as it lets developers focus on other things, and we get security patches
      // merged reasonably quickly.
      //
      // If this becomes a hasle we can consider setting automerge to false
      "automerge": true
    },
    {
      "description": "GitHub Actions - pinned to commit digest",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "automerge": false,
      // Make sure that we pin a version to its commit hash and not version,
      // as the latter is more vulnerable to supply-chain attacks.
      // We're not fully immune against it with pinning, but it helps greatly.
      "pinDigests": true
    },
    {
      "description": "nsbno/platform-actions - ignore completely, keep using @v2 major ref",
      "matchManagers": ["github-actions"],
      "matchPackagePatterns": ["^nsbno/platform-actions"],
      // For our own platform-actions we don't want Renovate to manage versions.
      // Teams should reference the major tag, i.e. @v2, so that Utviklerplattform can apply fixes
      // efficiently without requiring every project to manually upgrade the pipeline
      // whenever a new version is released.
      //
      // This has of course some tradeoff in security. But I'd argue the benefits are worth it
      // as it can also improve our security posture. For example by allowing Utviklerplatform
      // to centrally patch vulnerabilities in Github actions, and it will immediately affect all projects
      "enabled": false
    },
    {
      "description": "Docker digests",
      "matchManagers": ["docker-compose", "dockerfile"],
      "matchUpdateTypes": ["digest"],
      "automerge": false
    },
    {
      "description": "Terraform providers",
      "matchManagers": ["terraform"],
      "groupName": "terraform"
    },
    {
      "description": "Go modules",
      "matchManagers": ["gomod"],
      "groupName": "go-modules"
    },

    // Frontend grouping rules
    // (React, Jest, Babel, ESLint, webpack, Next.js, Angular, Vue, Vite,
    //  testing-library, Storybook, PostCSS, etc. are already handled by
    //  group:recommended and group:monorepos)
    {
      "description": "Tailwind CSS ecosystem",
      "matchPackagePatterns": ["^tailwindcss", "^@tailwindcss/"],
      "groupName": "tailwindcss"
    },
    {
      "description": "Sass/SCSS packages",
      "matchPackageNames": ["sass", "sass-loader", "sass-embedded"],
      "groupName": "sass"
    },
    {
      "description": "styled-components ecosystem",
      "matchPackagePatterns": ["^styled-components", "^@types/styled-components"],
      "groupName": "styled-components"
    },
    {
      "description": "Emotion CSS-in-JS",
      "matchPackagePatterns": ["^@emotion/"],
      "groupName": "emotion"
    },
    {
      "description": "esbuild ecosystem",
      "matchPackagePatterns": ["^esbuild", "^@esbuild/"],
      "groupName": "esbuild"
    },

    // JVM grouping rules
    {
      "description": "Kotlin ecosystem",
      "matchPackagePatterns": ["^org.jetbrains.kotlin:", "^org.jetbrains.kotlinx:"],
      "matchDatasources": ["maven"],
      "groupName": "kotlin"
    },
    {
      "description": "Micronaut ecosystem",
      "matchPackagePatterns": ["^io.micronaut"],
      "matchDatasources": ["maven"],
      "groupName": "micronaut"
    },

    // Python grouping rules
    // (Pulumi Python packages are already handled by group:recommended)
    {
      "description": "pytest ecosystem",
      "matchPackagePatterns": ["^pytest"],
      "matchDatasources": ["pypi"],
      "groupName": "pytest"
    },
    {
      "description": "Python linting and formatting tools",
      "matchPackageNames": ["ruff", "black", "isort", "flake8", "pylint", "autopep8", "pycodestyle", "pyflakes", "bandit"],
      "matchDatasources": ["pypi"],
      "groupName": "python-linters"
    },
    {
      "description": "Python type checking",
      "matchPackageNames": ["mypy", "pyright", "types-requests", "types-setuptools"],
      "matchPackagePatterns": ["^types-", "^mypy-"],
      "matchDatasources": ["pypi"],
      "groupName": "python-type-checking"
    },
    {
      "description": "AWS SDK for Python",
      "matchPackageNames": ["boto3", "botocore", "s3transfer", "awscli"],
      "matchDatasources": ["pypi"],
      "groupName": "aws-python-sdk"
    },
    {
      "description": "FastAPI ecosystem",
      "matchPackageNames": ["fastapi", "uvicorn", "starlette", "httpx"],
      "matchDatasources": ["pypi"],
      "groupName": "fastapi"
    },
    {
      "description": "Django ecosystem",
      "matchPackagePatterns": ["^django", "^Django"],
      "matchDatasources": ["pypi"],
      "groupName": "django"
    },
    {
      "description": "Flask ecosystem",
      "matchPackagePatterns": ["^flask", "^Flask"],
      "matchDatasources": ["pypi"],
      "groupName": "flask"
    },
    {
      "description": "Pydantic ecosystem",
      "matchPackagePatterns": ["^pydantic"],
      "matchDatasources": ["pypi"],
      "groupName": "pydantic"
    }
  ],

  "vulnerabilityAlerts": {
    "labels": ["security"],
    "minimumReleaseAge": "0 days"
  }
}